# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Origine publică, folosită pentru sitemap și OG. Local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3002

# Supabase → Project Settings → API Keys → Secret. Trece peste regulile de acces,
# deci rămâne pe server: o folosește doar ruta care ține minte adresele.
# Local, o găsești în ieșirea lui `pnpm exec supabase status`.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx
